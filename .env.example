# Database
DATABASE_URL="postgresql://user:password@localhost:5432/apostilas_rf"

# JWT Secret (gere uma chave segura para produção)
JWT_SECRET="sua-chave-secreta-super-segura-aqui"

# Google Drive API Configuration (Service Account)
# Setup: https://console.cloud.google.com/ → Create Service Account → Download JSON
# Cole os valores do JSON baixado:
GOOGLE_DRIVE_PROJECT_ID="seu-projeto-id"
GOOGLE_DRIVE_PRIVATE_KEY_ID="sua-private-key-id"
GOOGLE_DRIVE_SERVICE_ACCOUNT_EMAIL="seu-service-account@seu-projeto.iam.gserviceaccount.com"
GOOGLE_DRIVE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_CLIENT_ID="seu-client-id"
GOOGLE_DRIVE_CLIENT_X509_CERT_URL="sua-cert-url"
GOOGLE_DRIVE_FOLDER_ID="root"

# Email Configuration (Gmail SMTP)
# Para usar Gmail, gere uma "App Password" em https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="seu-email@gmail.com"
SMTP_PASS="sua-senha-app-do-gmail"
SMTP_FROM="apostilas@rfducacao.com.br"
SMTP_FROM_NAME="RF Apostilas"

# App Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
